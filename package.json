{
  "name": "gitdiagram-local",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "node scripts/serve.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:server": "node --test scripts/*.test.mjs",
    "check:local": "node scripts/check-local-only.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:server && npm run check:local",
    "format:write": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "mermaid": "11.17.2",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "jsdom": "30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "5.0.1",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "^8.5.28"
  },
  "engines": {
    "node": ">=22.23.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}
